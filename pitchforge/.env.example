# Pitchforge pipeline environment variables
# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sync PostgreSQL connection string — used by psycopg2 in retriever + setup_rag
# Must use plain postgresql:// (no +asyncpg) — that prefix is SQLAlchemy-only
# The backend's DATABASE_URL uses postgresql+asyncpg:// — keep them separate
DATABASE_URL_SYNC=postgresql://pitchforge:pitchforge_dev@localhost:5432/pitchforge
