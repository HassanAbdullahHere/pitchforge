# Pitchforge pipeline environment variables
# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string — sync psycopg2 driver (pitchforge nodes are sync)
# Do NOT use +asyncpg here — that's only for the backend's async engine
DATABASE_URL=postgresql://pitchforge:pitchforge_dev@localhost:5432/pitchforge
