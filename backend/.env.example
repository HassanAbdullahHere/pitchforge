# Backend environment variables
# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (async driver for runtime)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://pitchforge:pitchforge_dev@localhost:5432/pitchforge

# CORS allowed origins — comma-separated, no trailing slashes
# Dev default: localhost:3000 and localhost:5173 (Vite)
# Production: set to your actual frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth — Client ID from Google Cloud Console (safe to expose; verified server-side)
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value. Rotate this if it leaks.
JWT_SECRET_KEY=your_jwt_secret_key_here
