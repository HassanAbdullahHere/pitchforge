# Frontend environment variables
# Copy to .env and fill in real values. Never commit .env.

# Production API base URL — used when deploying frontend separately from backend.
# In dev, Vite proxies /api/* → localhost:8000 via vite.config.js (no need to set this).
# VITE_API_BASE_URL=https://api.yourdomain.com

# Google OAuth Client ID — from Google Cloud Console → Credentials
# Safe to expose in frontend code (it's a public identifier, not a secret)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
